{
  "title": "秘書交接清冊",
  "subtitle": "社區秘書／行政人員交接",
  "pages": [
    {"id": "sec_basic", "title": "交接基本資料", "description": "社區名稱、日期與填寫人會自動帶入，請確認後再填寫接任人。"},
    {"id": "sec_fees", "title": "管理費與帳務", "description": "請確認收費方式、欠繳情形、零用金與單據。"},
    {"id": "sec_residents", "title": "住戶資料", "description": "住戶名冊、車位與處理中的住戶陳情。"},
    {"id": "sec_documents", "title": "文件與印鑑", "description": "印鑑、合約、會議紀錄與公告。"},
    {"id": "sec_frontdesk", "title": "櫃台與收發", "description": "包裹、門禁卡與訪客登記。"},
    {"id": "sec_accounts", "title": "電腦與帳號", "description": "需要交接的系統帳號與密碼。"},
    {"id": "sec_notes", "title": "其他交接事項", "description": "尚未完成的工作、聯絡窗口與備註。"}
  ],
  "questions": [
    {"id": "community_name", "label": "社區名稱", "type": "text", "required": true, "pageId": "sec_basic", "group": "社區", "prefill": "community"},
    {"id": "handover_date", "label": "交接日期", "type": "date", "required": true, "pageId": "sec_basic", "group": "交接人員", "prefill": "today"},
    {"id": "outgoing_secretary", "label": "交接人（離任秘書）", "type": "text", "required": true, "pageId": "sec_basic", "group": "交接人員", "prefill": "user"},
    {"id": "incoming_secretary", "label": "接任人（新任秘書）", "type": "text", "required": true, "pageId": "sec_basic", "group": "交接人員"},
    {"id": "supervisor", "label": "監交人（總幹事／主管）", "type": "text", "required": false, "pageId": "sec_basic", "group": "交接人員"},

    {"id": "fee_methods", "label": "管理費收繳方式", "type": "checkbox", "required": false, "pageId": "sec_fees", "group": "管理費", "options": ["現金", "匯款／轉帳", "超商代收", "信用卡", "其他"], "prefill": "last"},
    {"id": "fee_arrears_has", "label": "目前是否有欠繳管理費的住戶？", "type": "yesno", "required": true, "pageId": "sec_fees", "group": "管理費"},
    {"id": "fee_arrears_list", "label": "欠繳戶別、月份與金額", "type": "textarea", "required": true, "pageId": "sec_fees", "group": "管理費", "help": "例如：A棟5F-1，3～5月，共 6,000 元，已寄催繳單", "showIf": {"q": "fee_arrears_has", "op": "eq", "value": "是"}},
    {"id": "petty_cash", "label": "零用金餘額（元）", "type": "money", "required": true, "pageId": "sec_fees", "group": "現金與單據"},
    {"id": "receipts_status", "label": "收據／發票本使用狀況", "type": "textarea", "required": false, "pageId": "sec_fees", "group": "現金與單據", "help": "最後使用的號碼、剩餘本數、存放位置"},
    {"id": "bookkeeping", "label": "記帳方式", "type": "radio", "required": false, "pageId": "sec_fees", "group": "帳務", "options": ["會計系統", "Excel", "手寫帳簿", "其他"], "prefill": "last"},
    {"id": "monthly_report_done", "label": "本月財務報表是否已完成？", "type": "yesno", "required": false, "pageId": "sec_fees", "group": "帳務"},
    {"id": "monthly_report_todo", "label": "尚未完成的部分與預定完成日", "type": "textarea", "required": true, "pageId": "sec_fees", "group": "帳務", "showIf": {"q": "monthly_report_done", "op": "eq", "value": "否"}},

    {"id": "roster_location", "label": "住戶名冊存放位置", "type": "text", "required": false, "pageId": "sec_residents", "group": "住戶名冊", "help": "紙本櫃位或電腦資料夾路徑", "prefill": "last"},
    {"id": "resident_changes", "label": "近期遷入、遷出或過戶", "type": "textarea", "required": false, "pageId": "sec_residents", "group": "住戶名冊"},
    {"id": "parking_status", "label": "汽機車位登記狀況", "type": "textarea", "required": false, "pageId": "sec_residents", "group": "車位", "prefill": "last"},
    {"id": "complaints_has", "label": "是否有處理中的住戶陳情或糾紛？", "type": "yesno", "required": true, "pageId": "sec_residents", "group": "陳情與糾紛"},
    {"id": "complaints_list", "label": "陳情內容與目前處理進度", "type": "textarea", "required": true, "pageId": "sec_residents", "group": "陳情與糾紛", "showIf": {"q": "complaints_has", "op": "eq", "value": "是"}},

    {"id": "seals", "label": "保管中的印鑑", "type": "checkbox", "required": false, "pageId": "sec_documents", "group": "印鑑", "options": ["管委會大印", "主委章", "財委章", "管理中心章", "收發章", "其他"], "prefill": "last"},
    {"id": "seal_location", "label": "印鑑保管位置與保管人", "type": "text", "required": false, "pageId": "sec_documents", "group": "印鑑", "prefill": "last", "showIf": {"q": "seals", "op": "filled", "value": ""}},
    {"id": "documents_location", "label": "合約、會議紀錄與公文存放位置", "type": "textarea", "required": false, "pageId": "sec_documents", "group": "文件", "prefill": "last"},
    {"id": "meeting_upcoming_has", "label": "近期是否有管委會或區權會會議？", "type": "yesno", "required": false, "pageId": "sec_documents", "group": "會議"},
    {"id": "meeting_upcoming", "label": "會議日期與尚待準備的事項", "type": "textarea", "required": true, "pageId": "sec_documents", "group": "會議", "showIf": {"q": "meeting_upcoming_has", "op": "eq", "value": "是"}},
    {"id": "announcements", "label": "公告中或待張貼的公告", "type": "textarea", "required": false, "pageId": "sec_documents", "group": "公告"},

    {"id": "packages_pending", "label": "目前待領包裹數量", "type": "number", "required": false, "pageId": "sec_frontdesk", "group": "包裹"},
    {"id": "package_method", "label": "包裹收發登記方式", "type": "radio", "required": false, "pageId": "sec_frontdesk", "group": "包裹", "options": ["紙本登記", "管理系統", "其他"], "prefill": "last"},
    {"id": "card_stock", "label": "門禁卡／磁扣庫存數量", "type": "number", "required": false, "pageId": "sec_frontdesk", "group": "門禁卡", "prefill": "last"},
    {"id": "card_log", "label": "門禁卡發放紀錄存放位置", "type": "text", "required": false, "pageId": "sec_frontdesk", "group": "門禁卡", "prefill": "last"},
    {"id": "visitor_method", "label": "訪客／廠商進出登記方式", "type": "textarea", "required": false, "pageId": "sec_frontdesk", "group": "訪客", "prefill": "last"},

    {"id": "accounts_list", "label": "需要交接的帳號", "type": "checkbox", "required": false, "pageId": "sec_accounts", "group": "帳號", "options": ["社區電腦開機密碼", "社區電子郵件", "社區 LINE 官方帳號", "雲端硬碟", "管理系統", "網路銀行（查詢）", "其他"], "prefill": "last"},
    {"id": "accounts_handed", "label": "帳號密碼是否已當面交付？", "type": "yesno", "required": true, "pageId": "sec_accounts", "group": "帳號", "help": "密碼請當面交付，不要寫在這份清冊上"},
    {"id": "accounts_todo", "label": "尚未交付的帳號與預定交付時間", "type": "textarea", "required": true, "pageId": "sec_accounts", "group": "帳號", "showIf": {"q": "accounts_handed", "op": "eq", "value": "否"}},

    {"id": "pending_tasks", "label": "尚未完成的工作", "type": "textarea", "required": false, "pageId": "sec_notes", "group": "待辦"},
    {"id": "important_contacts", "label": "重要聯絡窗口（管委會、廠商等）", "type": "textarea", "required": false, "pageId": "sec_notes", "group": "聯絡窗口", "prefill": "last"},
    {"id": "remarks", "label": "其他備註", "type": "textarea", "required": false, "pageId": "sec_notes", "group": "其他"}
  ]
}
